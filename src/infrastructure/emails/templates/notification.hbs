<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #4f46e5;
      color: white;
      padding: 20px;
      text-align: center;
      border-radius: 5px 5px 0 0;
    }
    .content {
      background-color: #f9fafb;
      padding: 30px;
      border-radius: 0 0 5px 5px;
    }
    .title {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 15px;
      color: #1f2937;
    }
    .body {
      font-size: 16px;
      color: #4b5563;
      margin-bottom: 20px;
    }
    .footer {
      text-align: center;
      margin-top: 30px;
      font-size: 12px;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>SellerSwift Insights</h1>
  </div>
  <div class="content">
    <div class="title">{{title}}</div>
    <div class="body">{{body}}</div>
    {{#if data}}
      {{#if data.url}}
        <a href="{{data.url}}" style="display: inline-block; background-color: #4f46e5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; margin-top: 20px;">View Details</a>
      {{/if}}
    {{/if}}
    <div class="footer">
      <p>This is an automated notification from SellerSwift Insights.</p>
      <p>You can manage your notification preferences in your account settings.</p>
    </div>
  </div>
</body>
</html>

